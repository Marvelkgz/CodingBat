pipeline {
    agent any
    tools {
        gradle 'Gradle 8.14.3'
        jdk 'JDK21'
    }
    parameters {
        string(name: 'BRANCH', defaultValue: 'sumi', description: 'Укажите ветку')
        choice(name: 'TEST_SUITE', choices: ['smokeUIAndApiTest', 'regressionTest', 'e2eTest'],
               description: 'Выберите suite')
        string(name: 'CUSTOM_TEST', defaultValue: '', description: 'Конкретный тест')
        booleanParam(name: 'RERUN_FAILED', defaultValue: false, description: 'Перезапуск упавших')
    }

    environment {
        ALLURE_RESULTS_DIR = 'build/allure-results'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/Marvelkgz/CodingBat.git',
                    branch: "${params.BRANCH}"
            }
        }

        stage('Resolve test task') {
            steps {
                script {
                    def suiteMap = [
                        smokeUIAndApiTest: 'smokeUIAndApiTest',
                        regressionTest:    'regressionTest',
                        e2eTest:           'e2eTest'
                    ]
                    env.GRADLE_TASK = suiteMap[params.TEST_SUITE] ?: 'smokeUIAndApiTest'
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    if (params.CUSTOM_TEST?.trim()) {
                        bat "gradle ${env.GRADLE_TASK} --tests ${params.CUSTOM_TEST} --continue"
                    } else {
                        bat "gradle ${env.GRADLE_TASK} --continue"
                    }
                }
            }
        }
    }

post {
    always {
        node('') {
            allure includeProperties: false,
                   results: [[path: 'C:\\Users\\marve\\.jenkins\\workspace\\Ray\\build\\allure-results']]

            script {
                def status    = currentBuild.currentResult
                def duration  = currentBuild.durationString
                def allureUrl = "${env.BUILD_URL}allure/"
                def suiteInfo = params.CUSTOM_TEST?.trim()
                    ? "Test: ${params.CUSTOM_TEST}"
                    : "Suite: ${params.TEST_SUITE}"

                // Без эмодзи — только ASCII и кириллица
                def telegramText = "[${status}] Pipeline: f_tests\n" +
                                   "Статус: ${status}\n" +
                                   "Ветка: ${params.BRANCH}\n" +
                                   "${suiteInfo}\n" +
                                   "Длительность: ${duration}\n" +
                                   "Allure: ${allureUrl}"

                // Записываем текст в файл чтобы избежать проблем с кодировкой и переносами
                writeFile file: 'telegram_msg.txt', text: telegramText

                withCredentials([
                    string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                    string(credentialsId: 'telegram-chat-id',   variable: 'CHAT_ID')
                ]) {
                    bat """
                        curl -k -s -X POST "https://api.telegram.org/bot%BOT_TOKEN%/sendMessage" ^
                        --data-urlencode "chat_id=%CHAT_ID%" ^
                        --data-urlencode "text@telegram_msg.txt"
                    """
                }
            }
        }
    }
}
}