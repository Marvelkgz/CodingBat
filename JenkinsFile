pipeline {
    agent any
    tools {
        gradle 'Gradle 8.14.3'
        jdk 'JDK21'
    }
    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'Укажите ветку')
        choice(name: 'TEST_SUITE', choices: ['smoke', 'regression', 'e2e', 'api'], description: 'Выберите suite')
        string(name: 'CUSTOM_TEST', defaultValue: '', description: 'Конкретный тест')
        booleanParam(name: 'RERUN_FAILED', defaultValue: false, description: 'Перезапуск упавших')
    } // Исправлено: убрана лишняя круглая скобка

    environment {
        TELEGRAM_BOT_TOKEN = credentials('telegram-bot-token')
        TELEGRAM_CHAT_ID   = credentials('telegram-chat-id')
        ALLURE_RESULTS_DIR = 'build/allure-results'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/Marvelkgz/CodingBat.git', branch: "${params.BRANCH}"
            }
        }
        stage('Resolve test task') {
            steps {
                script {
                    def suiteMap = [
                        smoke:      'smokeUIAndApiTest',
                        regression: 'regressionTest',
                        e2e:        'e2eTest',
                        api:        'e2eTest'
                    ]
                    env.GRADLE_TASK = suiteMap[params.TEST_SUITE] ?: 'smokeUIAndApiTest'
                }
            }
        }
        stage('Run Tests') {
            steps {
                script {
                    if (params.CUSTOM_TEST?.trim()) {
                        bat "gradle ${env.GRADLE_TASK} --tests \"${params.CUSTOM_TEST}\" --continue"
                    } else {
                        bat "gradle ${env.GRADLE_TASK} --continue"
                    }
                }
            }
        }
    }

    post {
        always {
            allure includeProperties: false, results: [[path: "${env.ALLURE_RESULTS_DIR}"]]
            script {
                def status    = currentBuild.currentResult
                def emoji     = (status == 'SUCCESS') ? '✅ SUCCESS' : '❌ FAILURE'
                def duration  = currentBuild.durationString
                def allureUrl = "${env.BUILD_URL}allure/"

                // Объявляем переменную suite, иначе будет ошибка
                def suiteInfo = params.CUSTOM_TEST?.trim() ? "Тест: ${params.CUSTOM_TEST}" : "Suite: ${params.TEST_SUITE}"

                // Формируем сообщение в формате HTML (так как parse_mode=HTML)
                def msg = "<b>${emoji} Pipeline: f_tests</b>%0A" +
                          "Статус: <b>${status}</b>%0A" +
                          "Ветка: ${params.BRANCH}%0A" +
                          "${suiteInfo}%0A" +
                          "Длительность: ${duration}%0A" +
                          "<a href='${allureUrl}'>📊 Открыть Allure-отчёт</a>"

                bat """
                curl -s -X POST "https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/sendMessage" ^
                -d "chat_id=${env.TELEGRAM_CHAT_ID}" ^
                -d "parse_mode=HTML" ^
                -d "text=${msg}"
                """
            }
        }
    }
}