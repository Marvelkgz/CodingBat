pipeline {
    agent any
    tools {
        gradle 'Gradle 8.14.3'
        jdk 'JDK21'
    }
    parameters {
        string(name: 'BRANCH', defaultValue: 'sumi', description: 'Укажите ветку')
        choice(name: 'TEST_SUITE', choices: ['smokeTest', 'regressionTest', 'e2eTest', 'apiTest'],
               description: 'Выберите suite')
        string(name: 'CUSTOM_TEST', defaultValue: '', description: 'Конкретный тест')
        booleanParam(name: 'RERUN_FAILED', defaultValue: false, description: 'Перезапуск упавших')
    }

    environment {
        ALLURE_RESULTS_DIR = 'build/allure-results'
    }

    stages {
        stage('Save Workspace') {
            steps {
                script {
                    env.MAIN_WORKSPACE = env.WORKSPACE
                    echo "MAIN_WORKSPACE saved: ${env.MAIN_WORKSPACE}"
                }
            }
        }

        stage('Checkout') {
            steps {
                git url: 'https://github.com/Marvelkgz/CodingBat.git',
                    branch: "${params.BRANCH}"
            }
        }

        stage('Resolve test task') {
            steps {
                script {
                    def suiteMap = [
                        smokeTest:      'smokeTest',
                        regressionTest: 'regressionTest',
                        e2eTest:        'e2eTest',
                        apiTest:        'apiTest'
                    ]
                    env.GRADLE_TASK = suiteMap[params.TEST_SUITE] ?: 'smokeTest'
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    if (params.CUSTOM_TEST?.trim()) {
                        def testFilter = params.CUSTOM_TEST.contains('*')
                            ? params.CUSTOM_TEST
                            : "*${params.CUSTOM_TEST}*"
                        bat "gradle ${env.GRADLE_TASK} --tests \"${testFilter}\" --continue"
                    } else {
                        bat "gradle ${env.GRADLE_TASK} --continue"
                    }
                }
            }
        }
    }

    post {
        always {
            node('') {
                script {
                    echo "MAIN_WORKSPACE in post: ${env.MAIN_WORKSPACE}"
                }

                allure includeProperties: false,
                       results: [[path: "${env.MAIN_WORKSPACE}\\${env.ALLURE_RESULTS_DIR}"]]

                script {
                    def status    = currentBuild.currentResult
                    def duration  = currentBuild.durationString
                    def buildNum  = env.BUILD_NUMBER
                    def jobName   = env.JOB_NAME
                    def ps        = 'C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe'
                    def suiteInfo = params.CUSTOM_TEST?.trim()
                        ? "Test: ${params.CUSTOM_TEST}"
                        : "Suite: ${params.TEST_SUITE}"

                    def xmlDir = "${env.MAIN_WORKSPACE}\\build\\test-results\\${env.GRADLE_TASK}"

                    // --- Читаем XML через PowerShell, без new File() ---
                    def passed  = 0
                    def failed  = 0
                    def skipped = 0

                    def psResult = bat(returnStdout: true, script: """
                        ${ps} -Command "
                        \$passed=0; \$failed=0; \$skipped=0;
                        Get-ChildItem '${xmlDir}' -Filter '*.xml' -ErrorAction SilentlyContinue | ForEach-Object {
                            [xml]\$x = Get-Content \$_.FullName;
                            \$t = [int]\$x.testsuite.tests;
                            \$f = [int]\$x.testsuite.failures + [int]\$x.testsuite.errors;
                            \$s = [int]\$x.testsuite.skipped;
                            \$passed += (\$t - \$f - \$s); \$failed += \$f; \$skipped += \$s
                        };
                        Write-Output \\"PASSED=\$passed;FAILED=\$failed;SKIPPED=\$skipped\\"
                        "
                    """).trim()

                    def lines = psResult.split('\n')
                    def dataLine = lines.find { it.contains('PASSED=') } ?: 'PASSED=0;FAILED=0;SKIPPED=0'
                    dataLine.split(';').each { pair ->
                        def kv = pair.trim().split('=')
                        if (kv[0] == 'PASSED')  passed  = kv[1].toInteger()
                        if (kv[0] == 'FAILED')  failed  = kv[1].toInteger()
                        if (kv[0] == 'SKIPPED') skipped = kv[1].toInteger()
                    }

                    def total      = passed + failed + skipped
                    def passedPct  = total > 0 ? Math.round(passed  * 100.0 / total) : 0
                    def failedPct  = total > 0 ? Math.round(failed  * 100.0 / total) : 0
                    def skippedPct = total > 0 ? Math.round(skipped * 100.0 / total) : 0

                    // --- Генерируем HTML с donut-графиком ---
                    def passedOffset  = 25
                    def failedOffset  = 25 - passedPct
                    def skippedOffset = 25 - passedPct - failedPct

                    def htmlChart = """<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
body{font-family:Arial,sans-serif;background:#fff;margin:0;padding:20px;width:500px;}
h2{font-size:16px;margin-bottom:10px;}
.wrap{display:flex;align-items:center;gap:30px;}
.donut{position:relative;width:160px;height:160px;}
.donut svg{width:160px;height:160px;}
.total{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:30px;font-weight:bold;}
.legend{font-size:13px;display:flex;flex-direction:column;gap:6px;}
.li{display:flex;align-items:center;gap:8px;}
.box{width:14px;height:14px;border-radius:2px;}
.info{margin-top:10px;font-size:12px;color:#555;}
</style></head><body>
<h2>${jobName} — Build #${buildNum}</h2>
<div class="wrap">
  <div class="donut">
    <svg viewBox="0 0 36 36">
      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#eee" stroke-width="4"/>
      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#7cb342" stroke-width="4"
        stroke-dasharray="${passedPct} ${100-passedPct}" stroke-dashoffset="${passedOffset}"/>
      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e53935" stroke-width="4"
        stroke-dasharray="${failedPct} ${100-failedPct}" stroke-dashoffset="${failedOffset}"/>
      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#fdd835" stroke-width="4"
        stroke-dasharray="${skippedPct} ${100-skippedPct}" stroke-dashoffset="${skippedOffset}"/>
    </svg>
    <div class="total">${total}</div>
  </div>
  <div class="legend">
    <div class="li"><div class="box" style="background:#7cb342"></div>✅ ${passed} прошло (${passedPct}%)</div>
    <div class="li"><div class="box" style="background:#e53935"></div>❌ ${failed} упало (${failedPct}%)</div>
    <div class="li"><div class="box" style="background:#fdd835"></div>⏭ ${skipped} пропущено (${skippedPct}%)</div>
  </div>
</div>
<div class="info">
  Статус: <b>${status}</b> | Ветка: <b>${params.BRANCH}</b><br>
  ${suiteInfo} | Длительность: ${duration}
</div>
</body></html>"""

                    def htmlFile = "${env.WORKSPACE}\\chart.html"
                    def pngFile  = "${env.WORKSPACE}\\chart.png"
                    writeFile file: htmlFile, text: htmlChart

                    // HTML → PNG через Chrome headless
                    bat """
                        "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" ^
                        --headless --disable-gpu ^
                        --screenshot="${pngFile}" ^
                        --window-size=540,280 ^
                        "${htmlFile}"
                    """

                    // Архив HTML отчёта
                    def reportDir = "${env.MAIN_WORKSPACE}\\build\\reports\\tests\\${env.GRADLE_TASK}"
                    def reportZip = "${env.WORKSPACE}\\test-report.zip"
                    bat """
                        ${ps} -Command "Compress-Archive -Force -Path '${reportDir}' -DestinationPath '${reportZip}'"
                    """

                    // Текст для Telegram
                    def telegramText = "[${status}] Pipeline: ${jobName}\n" +
                        "Статус: ${status}\n" +
                        "Ветка: ${params.BRANCH}\n" +
                        "${suiteInfo}\n" +
                        "Длительность: ${duration}\n" +
                        "Всего: ${total} | ✅ ${passed} | ❌ ${failed} | ⏭ ${skipped}"

                    writeFile file: "${env.WORKSPACE}\\telegram_msg.txt", text: telegramText

                    withCredentials([
                        string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                        string(credentialsId: 'telegram-chat-id',   variable: 'CHAT_ID')
                    ]) {
                        // Картинка с графиком
                        bat """
                            curl -k -s -X POST "https://api.telegram.org/bot%BOT_TOKEN%/sendPhoto" ^
                            -F "chat_id=%CHAT_ID%" ^
                            -F "photo=@${pngFile}" ^
                            -F "caption@${env.WORKSPACE}\\telegram_msg.txt"
                        """

                        // ZIP с HTML отчётом
                        bat """
                            curl -k -s -X POST "https://api.telegram.org/bot%BOT_TOKEN%/sendDocument" ^
                            -F "chat_id=%CHAT_ID%" ^
                            -F "document=@${reportZip}" ^
                            -F "caption=HTML отчет - Build ${buildNum}"
                        """
                    }
                }
            }
        }
    }
}