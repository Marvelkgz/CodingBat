pipeline {
    agent any
    tools {
        gradle 'Gradle 8.14.3'
        jdk 'JDK21'
    }
    parameters {
        string(name: 'BRANCH', defaultValue: 'sumi', description: 'Укажите ветку')
        choice(name: 'TEST_SUITE', choices: ['smokeUIAndApiTest', 'regressionTest', 'e2eTest'],
               description: 'Выберите suite')
        string(name: 'CUSTOM_TEST', defaultValue: '', description: 'Конкретный тест')
        booleanParam(name: 'RERUN_FAILED', defaultValue: false, description: 'Перезапуск упавших')
    }

    environment {
        ALLURE_RESULTS_DIR = 'build/allure-results'
    }

    stages {
        stage('Save Workspace') {
            steps {
                script {
                    env.MAIN_WORKSPACE = env.WORKSPACE
                    echo "MAIN_WORKSPACE saved: ${env.MAIN_WORKSPACE}"
                }
            }
        }

        stage('Checkout') {
            steps {
                git url: 'https://github.com/Marvelkgz/CodingBat.git',
                    branch: "${params.BRANCH}"
            }
        }

        stage('Resolve test task') {
            steps {
                script {
                    def suiteMap = [
                        smokeUIAndApiTest: 'smokeUIAndApiTest',
                        regressionTest:    'regressionTest',
                        e2eTest:           'e2eTest'
                    ]
                    env.GRADLE_TASK = suiteMap[params.TEST_SUITE] ?: 'smokeUIAndApiTest'
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    if (params.CUSTOM_TEST?.trim()) {
                        def testFilter = params.CUSTOM_TEST.contains('*')
                            ? params.CUSTOM_TEST
                            : "*${params.CUSTOM_TEST}*"
                        bat "gradle ${env.GRADLE_TASK} --tests \"${testFilter}\" --continue"
                    } else {
                        bat "gradle ${env.GRADLE_TASK} --continue"
                    }
                }
            }
        }
    }

    post {
        always {
            node('') {
                allure includeProperties: false,
                       results: [[path: "${env.MAIN_WORKSPACE}\\${env.ALLURE_RESULTS_DIR}"]]

                script {
                    // Считаем статистику из XML результатов
                    def passed = 0
                    def failed = 0
                    def total  = 0

                    try {
                        def xmlDir = new File("${env.MAIN_WORKSPACE}\\build\\test-results\\${env.GRADLE_TASK}")
                        xmlDir.eachFileMatch(~/.*\.xml/) { f ->
                            def xml = new XmlSlurper().parse(f)
                            def t  = (xml.@tests    as String).toInteger()
                            def fa = (xml.@failures as String).toInteger()
                            def e  = (xml.@errors   as String).toInteger()
                            total  += t
                            failed += fa + e
                            passed += t - fa - e
                        }
                    } catch(e) {
                        echo "Could not read XML results: ${e.message}"
                    }

                    def duration = currentBuild.durationString
                    def buildUrl = "http://localhost:8080/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/allure/"

                    withCredentials([
                        string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                        string(credentialsId: 'telegram-chat-id',   variable: 'CHAT_ID')
                    ]) {
                        bat """
                            cd /d "${env.MAIN_WORKSPACE}" && ^
                            gradle runTelegramReport ^
                            -Ppassed=${passed} ^
                            -Pfailed=${failed} ^
                            -Ptotal=${total} ^
                            -Pduration="${duration}" ^
                            -Pbranch="${params.BRANCH}" ^
                            -Psuite="${params.TEST_SUITE}" ^
                            -PbuildUrl="${buildUrl}" ^
                            -PbotToken=%BOT_TOKEN% ^
                            -PchatId=%CHAT_ID%
                        """
                    }
                }
            }
        }
    }
}