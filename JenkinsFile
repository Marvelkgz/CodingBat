pipeline {
    agent any
    tools {
        gradle 'Gradle 8.14.3'
        jdk 'JDK21'
    }
    parameters {
        string(name: 'BRANCH', defaultValue: 'sumi', description: 'Укажите ветку')
        choice(name: 'TEST_SUITE', choices: ['smokeTest', 'regressionTest', 'e2eTest','apiTest'],
               description: 'Выберите suite')
        string(name: 'CUSTOM_TEST', defaultValue: '', description: 'Конкретный тест')
        booleanParam(name: 'RERUN_FAILED', defaultValue: false, description: 'Перезапуск упавших')
    }

    environment {
        ALLURE_RESULTS_DIR = 'build/allure-results'
    }

    stages {
        // Отдельный stage — сохраняем workspace ДО всего остального
        stage('Save Workspace') {
            steps {
                script {
                    env.MAIN_WORKSPACE = env.WORKSPACE
                    echo "MAIN_WORKSPACE saved: ${env.MAIN_WORKSPACE}"
                }
            }
        }

        stage('Checkout') {
            steps {
                git url: 'https://github.com/Marvelkgz/CodingBat.git',
                    branch: "${params.BRANCH}"
            }
        }

        stage('Resolve test task') {
            steps {
                script {
                     def suiteMap = [
                                            smokeTest:      'smokeTest',
                                            regressionTest: 'regressionTest',
                                            e2eTest:        'e2eTest',
                                            apiTest:        'apiTest'
                                        ]
                    env.GRADLE_TASK = suiteMap[params.TEST_SUITE] ?: 'apiTest'
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    if (params.CUSTOM_TEST?.trim()) {
                        def testFilter = params.CUSTOM_TEST.contains('*')
                            ? params.CUSTOM_TEST
                            : "*${params.CUSTOM_TEST}*"
                        bat "gradle ${env.GRADLE_TASK} --tests \"${testFilter}\" --continue"
                    } else {
                        bat "gradle ${env.GRADLE_TASK} --continue"
                    }
                }
            }
        }
    }

    post {
        always {
              script {
                    echo "MAIN_WORKSPACE in post: ${env.MAIN_WORKSPACE}"
                }

                allure includeProperties: false,
                       results: [[path: "${env.MAIN_WORKSPACE}\\${env.ALLURE_RESULTS_DIR}"]]


                script {
                    def status   = currentBuild.currentResult
                    def duration = currentBuild.durationString
                    def buildNum = env.BUILD_NUMBER
                    def jobName  = env.JOB_NAME
                    def suiteInfo = params.CUSTOM_TEST?.trim()
                        ? "Test: ${params.CUSTOM_TEST}"
                        : "Suite: ${params.TEST_SUITE}"

                    // --- Читаем результаты тестов из XML ---
                    def passed  = 0
                    def failed  = 0
                    def skipped = 0
                    def xmlDir  = new File("${env.MAIN_WORKSPACE}\\build\\test-results\\${env.GRADLE_TASK}")
                    if (xmlDir.exists()) {
                        xmlDir.eachFileMatch(~/.*\.xml/) { file ->
                            def xml = new XmlSlurper().parse(file)
                            passed  += (xml.@tests.toInteger() - xml.@failures.toInteger() - xml.@errors.toInteger() - xml.@skipped.toInteger())
                            failed  += xml.@failures.toInteger() + xml.@errors.toInteger()
                            skipped += xml.@skipped.toInteger()
                        }
                    }
                    def total   = passed + failed + skipped
                    def passedPct  = total > 0 ? Math.round(passed  * 100.0 / total) : 0
                    def failedPct  = total > 0 ? Math.round(failed  * 100.0 / total) : 0
                    def skippedPct = total > 0 ? Math.round(skipped * 100.0 / total) : 0

                    // --- Генерируем HTML с графиком ---
                    def htmlChart = """<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  body { font-family: Arial, sans-serif; background: #fff; margin: 0; padding: 20px; width: 500px; }
  h2 { font-size: 18px; margin-bottom: 10px; }
  .chart-wrap { display: flex; align-items: center; gap: 30px; }
  .donut { position: relative; width: 180px; height: 180px; }
  .donut svg { width: 180px; height: 180px; }
  .donut-total { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); font-size: 32px; font-weight: bold; }
  .legend { display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
  .legend-item { display: flex; align-items: center; gap: 8px; }
  .legend-box { width: 16px; height: 16px; border-radius: 2px; }
</style>
</head>
<body>
<h2>${jobName} — Build #${buildNum}</h2>
<div class="chart-wrap">
  <div class="donut">
    <svg viewBox="0 0 36 36">
      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#eee" stroke-width="3.5"/>
      <!-- passed (green) -->
      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#7cb342" stroke-width="3.5"
        stroke-dasharray="${passedPct} ${100 - passedPct}"
        stroke-dashoffset="25" />
      <!-- failed (red) -->
      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e53935" stroke-width="3.5"
        stroke-dasharray="${failedPct} ${100 - failedPct}"
        stroke-dashoffset="${25 - passedPct}" />
      <!-- skipped (yellow) -->
      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#fdd835" stroke-width="3.5"
        stroke-dasharray="${skippedPct} ${100 - skippedPct}"
        stroke-dashoffset="${25 - passedPct - failedPct}" />
    </svg>
    <div class="donut-total">${total}</div>
  </div>
  <div class="legend">
    <div class="legend-item"><div class="legend-box" style="background:#7cb342"></div>${passed} прошло (${passedPct}%)</div>
    <div class="legend-item"><div class="legend-box" style="background:#e53935"></div>${failed} упало (${failedPct}%)</div>
    <div class="legend-item"><div class="legend-box" style="background:#fdd835"></div>${skipped} пропущено (${skippedPct}%)</div>
  </div>
</div>
<p style="margin-top:12px; font-size:13px; color:#555;">
  Статус: <b>${status}</b> | Ветка: <b>${params.BRANCH}</b><br>
  ${suiteInfo} | Длительность: ${duration}
</p>
</body>
</html>"""

                    def htmlFile = "${env.WORKSPACE}\\chart.html"
                    def pngFile  = "${env.WORKSPACE}\\chart.png"
                    writeFile file: htmlFile, text: htmlChart

                    // --- Конвертируем HTML в PNG через Chrome headless ---
                    def ps = 'C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe'
                    bat """
                        "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" ^
                        --headless --disable-gpu --screenshot="${pngFile}" ^
                        --window-size=540,300 "${htmlFile}"
                    """

                    // --- Архив HTML отчёта ---
                    def reportDir = "${env.MAIN_WORKSPACE}\\build\\reports\\tests\\${env.GRADLE_TASK}"
                    def reportZip = "${env.WORKSPACE}\\test-report.zip"
                    bat """
                        ${ps} -Command "Compress-Archive -Force -Path '${reportDir}' -DestinationPath '${reportZip}'"
                    """

                    // --- Telegram сообщение ---
                    def telegramText = "[${status}] Pipeline: ${jobName}\n" +
                                       "Статус: ${status}\n" +
                                       "Ветка: ${params.BRANCH}\n" +
                                       "${suiteInfo}\n" +
                                       "Длительность: ${duration}\n" +
                                       "Всего: ${total} | ✅ ${passed} | ❌ ${failed} | ⏭ ${skipped}"

                    writeFile file: "${env.WORKSPACE}\\telegram_msg.txt", text: telegramText

                    withCredentials([
                        string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                        string(credentialsId: 'telegram-chat-id',   variable: 'CHAT_ID')
                    ]) {
                        // Отправляем картинку-график
                        bat """
                            curl -k -s -X POST "https://api.telegram.org/bot%BOT_TOKEN%/sendPhoto" ^
                            -F "chat_id=%CHAT_ID%" ^
                            -F "photo=@${pngFile}" ^
                            -F "caption@${env.WORKSPACE}\\telegram_msg.txt"
                        """

                        // Отправляем ZIP с HTML отчётом
                        bat """
                            curl -k -s -X POST "https://api.telegram.org/bot%BOT_TOKEN%/sendDocument" ^
                            -F "chat_id=%CHAT_ID%" ^
                            -F "document=@${reportZip}" ^
                            -F "caption=HTML отчет - Build ${buildNum}"
                        """
                    }
                }
            }
        }
    }
}